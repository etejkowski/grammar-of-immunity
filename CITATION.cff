    affiliation: "Independent researcher, Fairview Heights, Illinois, USA"
repository-code: "https://github.com/etejkowski/grammar-of-immunity"
license: MIT
keywords:
  - T-cell receptor
  - TCR specificity prediction
  - CDR3
  - V(D)J recombination
  - epitope generalization
  - IMMREP23
  - VDJdb
  - negative result
